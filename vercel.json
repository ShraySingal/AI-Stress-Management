{
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/sw.js", "destination": "/frontend/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/frontend/manifest.webmanifest" },
    { "source": "/manifest.json", "destination": "/frontend/manifest.webmanifest" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}

