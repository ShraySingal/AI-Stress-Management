# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.dist-info/

# Virtual environment
.venv/
venv/
env/

# Data files (keep metadata, evaluation reports tracked)
dataset/*.csv
dataset/*.joblib

# Large binary - ignored (105MB exceeds GitHub limit)
capstone.db

# Compressed archives
files.zip
*.zip

# Screen recordings / media
*.mp4
*.avi
*.mkv
*.mov

# IDE / editor artefacts
.vscode/
.idea/
*.code-workspace

# Build artefacts
dist/
build/
*.egg

# Temp files
*.log
*.tmp
*.bak

# OS files
Thumbs.db
.DS_Store

# pytest cache
.pytest_cache/
